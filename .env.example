# Production template only. Copy to .env and replace every placeholder locally.
# Never commit a real password, JWT secret, or hosted database URL.
NODE_ENV=production
PORT=5050

# Production storage is PostgreSQL. Hosted endpoints keep TLS verification enabled.
STORE_DRIVER=postgres
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOSTNAME:5432/DATABASE?sslmode=require

# Use a unique random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
ORAC_REQUIRE_PASSWORD=true
ORAC_REQUIRE_APPROVED_TAX=true

# Comma-separated portal origins, with no trailing slash.
CORS_ORIGINS=https://portal.example.com
TRUST_PROXY_HOPS=1
RATE_LIMIT_DISABLED=false

# V5 remains isolated and disabled until its separate release gates are approved.
ORAC_V5_COMMERCIAL_WORKFLOW=disabled
ORAC_V5_INVOICE_WRITER=disabled
